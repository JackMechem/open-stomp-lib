"""Request pacing: one SysEx request in flight (docs/03)."""

from typing import Optional, final

from ._types import BytesLike

@final
class Request:
    @property
    def bytes(self) -> bytes: ...
    @property
    def expect(self) -> Optional[str]: ...
    @property
    def is_sync(self) -> bool: ...

@final
class Done:
    @property
    def request(self) -> Request: ...
    @property
    def answered(self) -> bool: ...

@final
class RequestQueue:
    """Times (``at``) are seconds since the queue was created; None = now."""

    def __new__(cls, timeout: float = 1.0) -> RequestQueue: ...
    def clear(self) -> None: ...
    def start_sync(self, requests: list[BytesLike]) -> None: ...
    def read(self, data: BytesLike) -> None: ...
    def write(self, data: BytesLike) -> None: ...
    def pop(self) -> Optional[Request]: ...
    def sent(self, request: Request, at: Optional[float] = None) -> None: ...
    def on_message(self, data: BytesLike) -> Optional[Done]: ...
    def expire(self, at: Optional[float] = None) -> Optional[Done]: ...
    @property
    def progress(self) -> tuple[int, int]: ...
    @property
    def in_flight(self) -> Optional[Request]: ...
    @property
    def is_empty(self) -> bool: ...
    def __len__(self) -> int: ...

def handshake() -> list[bytes]: ...
def follow_up(data: BytesLike) -> list[bytes]: ...
