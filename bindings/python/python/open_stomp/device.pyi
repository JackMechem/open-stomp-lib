"""The background connection engine."""

import os
from types import TracebackType
from collections.abc import Sequence
from typing import Literal, Optional, Union, final

from ._types import BytesLike
from .catalog import Module
from .records import Preset, Settings
from .state import Origin

@final
class Update:
    @property
    def kind(self) -> Literal["ports", "status", "sync", "message", "mark", "info", "reset"]: ...
    @property
    def ports(self) -> Optional[list[str]]: ...
    @property
    def status(self) -> Optional[Literal["disconnected", "connected", "replaying"]]: ...
    @property
    def port(self) -> Optional[str]: ...
    @property
    def output(self) -> Optional[bool]: ...
    @property
    def file(self) -> Optional[str]: ...
    @property
    def progress(self) -> Optional[float]: ...
    @property
    def done(self) -> Optional[int]: ...
    @property
    def total(self) -> Optional[int]: ...
    @property
    def at(self) -> Optional[float]: ...
    @property
    def origin(self) -> Optional[Origin]: ...
    @property
    def bytes(self) -> Optional[bytes]: ...
    @property
    def text(self) -> Optional[str]: ...
    @property
    def error(self) -> Optional[bool]: ...

@final
class Device:
    def __new__(
        cls,
        *,
        client_name: str = "Open Stomp",
        auto_connect: bool = True,
        sync: bool = True,
        reply_timeout: float = 1.0,
        scan_interval: float = 1.5,
    ) -> Device: ...
    def recv(self, timeout: Optional[float] = None) -> Optional[Update]: ...
    def try_recv(self) -> Optional[Update]: ...
    def drain(self) -> list[Update]: ...
    def __iter__(self) -> Device: ...
    def __next__(self) -> Update: ...
    def close(self) -> None: ...
    @property
    def closed(self) -> bool: ...
    def __enter__(self) -> Device: ...
    def __exit__(
        self,
        exc_type: Optional[type[BaseException]],
        exc: Optional[BaseException],
        tb: Optional[TracebackType],
    ) -> bool: ...
    def connect(self, port: str) -> None: ...
    def disconnect(self) -> None: ...
    def resync(self) -> None: ...
    def set_sync(self, on: bool) -> None: ...
    def replay(self, path: Union[str, os.PathLike[str]], speed: float = 4.0) -> None: ...
    def stop_replay(self) -> None: ...
    def send(self, data: BytesLike) -> None: ...
    def write(self, messages: list[BytesLike]) -> None: ...
    def select_preset(self, index: int) -> None: ...
    def set_head(self, module: Module, model: int, on: bool) -> None: ...
    def set_param(self, module: Module, slot: int, value: int) -> None: ...
    def set_volume(self, value: int) -> None: ...
    def show_page(self, module: Module) -> None: ...
    def looper_button(self, button: int) -> None: ...
    def save_preset(self, source_slot: int, preset: Preset) -> None: ...
    def import_user_amp(self, slot: int, name: str, data: Sequence[float], factor: float = 1.0) -> None: ...
    def delete_user_amp(self, slot: int) -> None: ...
    def import_user_ir(self, slot: int, name: str, data: Sequence[float]) -> None: ...
    def write_settings(self, settings: Settings) -> None: ...
