"""The pedal model every message is applied to."""

from typing import ClassVar, Literal, Optional, final

from ._types import BytesLike
from .catalog import Module
from .device import Update
from .records import Preset, Settings

@final
class Origin:
    PEDAL: ClassVar[Origin]
    HOST: ClassVar[Origin]
    def __int__(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Event:
    @property
    def origin(self) -> Origin: ...
    @property
    def category(
        self,
    ) -> Literal[
        "preset", "effect", "volume", "navigation", "looper", "drum", "tuner", "settings", "device", "protocol", "unknown"
    ]: ...
    @property
    def module(self) -> Optional[Module]: ...
    @property
    def label(self) -> str: ...
    @property
    def subject(self) -> str: ...
    @property
    def value(self) -> str: ...
    @property
    def coalesce(self) -> Optional[int]: ...
    @property
    def redundant(self) -> bool: ...
    @property
    def raw(self) -> bytes: ...

@final
class Looper:
    @property
    def state(self) -> int: ...
    @property
    def state_name(self) -> str: ...
    @property
    def layers(self) -> int: ...
    @property
    def rec_level(self) -> Optional[int]: ...
    @property
    def play_level(self) -> Optional[int]: ...
    @property
    def sync(self) -> Optional[bool]: ...
    @property
    def mode(self) -> Optional[int]: ...

@final
class Drum:
    @property
    def playing(self) -> bool: ...
    @property
    def pattern(self) -> Optional[int]: ...
    @property
    def level(self) -> Optional[int]: ...
    @property
    def bpm(self) -> Optional[int]: ...

@final
class Tuner:
    @property
    def active(self) -> bool: ...
    @property
    def detected(self) -> bool: ...
    @property
    def note(self) -> Optional[int]: ...
    @property
    def cents(self) -> Optional[int]: ...
    @property
    def cents_offset(self) -> Optional[int]: ...

@final
class DeviceState:
    """A model of the pedal. Attributes are snapshots (copies)."""

    def __new__(cls) -> DeviceState: ...
    def apply(self, data: BytesLike, origin: Origin) -> Event: ...
    def feed(self, update: Update) -> Optional[Event]:
        """Apply a "message" update (returns its Event); reset on "reset"; else None."""
    def select_preset(self, index: int) -> None: ...
    def stored(self, index: int) -> Optional[Preset]: ...
    def preset_name(self, index: int) -> Optional[str]: ...
    def model_name(self, module: Module, model: int) -> str: ...
    def modified(self) -> bool: ...
    @property
    def firmware(self) -> Optional[str]: ...
    @property
    def model_id(self) -> Optional[str]: ...
    @property
    def product(self) -> Optional[str]: ...
    @property
    def presets(self) -> list[Optional[Preset]]: ...
    @property
    def current(self) -> Optional[int]: ...
    @property
    def live(self) -> Preset: ...
    @property
    def live_known(self) -> bool: ...
    @property
    def page(self) -> Optional[Module]: ...
    @property
    def looper(self) -> Looper: ...
    @property
    def drum(self) -> Drum: ...
    @property
    def tuner(self) -> Tuner: ...
    @property
    def settings(self) -> Optional[Settings]: ...
    @property
    def user_amps(self) -> list[Optional[str]]: ...
    @property
    def user_irs(self) -> list[Optional[str]]: ...

def looper_state_name(state: int) -> str: ...
