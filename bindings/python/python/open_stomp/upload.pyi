"""User AMP (NAM, SysEx 0x58) and user IR (0x10 + 0x09) upload framing (docs/05)."""

from collections.abc import Sequence
from typing import Optional, final

from ._types import BytesLike

CHUNK_BYTES: int
UPLOAD_FLOATS: int
USER_SLOTS: int
USER_MODEL_BASE: int
AMP_INFO_LEN: int
IR_DATA_SUB: int
AMP_SUB_DATA: int
AMP_SUB_WRITE_INFO: int
AMP_SUB_READ_INFO: int
AMP_SUB_DELETE: int

@final
class Chunk:
    @staticmethod
    def parse(payload: BytesLike) -> Optional[Chunk]: ...
    @property
    def slot(self) -> int: ...
    @property
    def ir_slot(self) -> int: ...
    @property
    def sub(self) -> int: ...
    @property
    def offset(self) -> int: ...
    @property
    def total(self) -> int: ...
    @property
    def data(self) -> bytes: ...

@final
class Reassembler:
    def __new__(cls) -> Reassembler: ...
    def push(self, chunk: Chunk) -> Optional[tuple[int, list[float]]]: ...

@final
class UserAmpInfo:
    slot: int
    name: str
    factor: float
    def __new__(cls, slot: int, name: str, factor: float = 1.0) -> UserAmpInfo: ...
    @staticmethod
    def parse(payload: BytesLike) -> Optional[UserAmpInfo]: ...
    @property
    def raw(self) -> bytes: ...
    def to_raw(self) -> bytes: ...
    def write_frame(self) -> bytes: ...
    def __eq__(self, other: object, /) -> bool: ...

def check(slot: int, data: Sequence[float]) -> None: ...
def user_amp_upload(info: UserAmpInfo, data: Sequence[float]) -> list[bytes]: ...
def user_amp_delete(slot: int) -> bytes: ...
def user_ir_upload(slot: int, name: str, data: Sequence[float]) -> list[bytes]: ...
def user_ir_name(slot: int, name: str) -> bytes: ...
def data_frames(cmd: int, slot: int, sub: int, data: BytesLike) -> list[bytes]: ...
def floats_to_bytes(data: Sequence[float]) -> bytes: ...
def bytes_to_floats(data: BytesLike) -> list[float]: ...
