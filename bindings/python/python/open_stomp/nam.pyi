"""Neural Amp Modeler models: load, run, and convert for the pedal (docs/05)."""

import os
from collections.abc import Sequence
from typing import Optional, Union, final

TONE_BINS: list[int]
FFT_SIZE: int

@final
class Model:
    @staticmethod
    def load(path: Union[str, os.PathLike[str]]) -> Model: ...
    @staticmethod
    def from_json(text: str) -> Model: ...
    def process(self, samples: Sequence[float]) -> list[float]: ...
    def reset(self) -> None: ...
    @property
    def name(self) -> Optional[str]: ...
    @property
    def architecture(self) -> str: ...
    @property
    def sample_rate(self) -> Optional[float]: ...

@final
class Converted:
    @property
    def data(self) -> list[float]:
        """The 2048 floats to upload (g1 + g2)."""
    @property
    def factor(self) -> float: ...
    @property
    def levels(self) -> list[float]: ...
    @property
    def levels3(self) -> list[float]: ...
    @property
    def bla_db(self) -> list[float]: ...
    @property
    def g1_gains_db(self) -> list[float]: ...
    @property
    def g1_ir(self) -> list[float]: ...
    @property
    def g2_ir(self) -> list[float]: ...

def convert(
    model: Union[Model, str, os.PathLike[str]], excitation: Optional[Sequence[float]] = None
) -> Converted: ...
def excitation() -> list[float]: ...
