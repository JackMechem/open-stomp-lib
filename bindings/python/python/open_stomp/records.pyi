"""Data records carried in SysEx (docs/04)."""

from typing import Any, Optional, final

from ._types import BytesLike
from .catalog import Module

PRESET_COUNT: int
PRESET_LEN: int
DEFAULT_CHAIN: list[Module]

@final
class ModuleState:
    on: bool
    model: int
    params: list[int]
    def __new__(cls, on: bool = False, model: int = 0, params: Optional[list[int]] = None) -> ModuleState: ...
    @property
    def head(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...

@final
class Preset:
    """A preset record. Attributes return copies; use set_module / set_param to edit modules."""

    index: int
    name: str
    volume: int
    chain: list[Module]
    modules: list[ModuleState]
    def __new__(cls) -> Preset: ...
    @staticmethod
    def from_packed(data: BytesLike) -> Preset: ...
    @staticmethod
    def from_raw(data: BytesLike) -> Preset: ...
    def to_raw(self) -> bytes: ...
    def to_packed(self) -> bytes: ...
    def module(self, m: Module) -> ModuleState: ...
    def set_module(
        self,
        module: Module,
        *,
        on: Optional[bool] = None,
        model: Optional[int] = None,
        params: Optional[list[int]] = None,
    ) -> None: ...
    def set_param(self, module: Module, slot: int, value: int) -> None: ...
    @property
    def raw(self) -> bytes: ...
    def same_sound(self, other: Preset) -> bool: ...
    def copy(self) -> Preset: ...
    def __copy__(self) -> Preset: ...
    def __deepcopy__(self, _memo: Any) -> Preset: ...
    def __eq__(self, other: object, /) -> bool: ...

@final
class Settings:
    input_trim: int
    eq_bass: int
    eq_mid: int
    eq_treble: int
    wireless: bool
    loopback: bool
    @staticmethod
    def from_packed(data: BytesLike) -> Settings: ...
    def to_raw(self) -> bytes: ...
    def to_packed(self) -> bytes: ...
    @property
    def input_trim_db(self) -> int: ...
    @property
    def raw(self) -> bytes: ...
    def copy(self) -> Settings: ...
    def __copy__(self) -> Settings: ...
    def __eq__(self, other: object, /) -> bool: ...

def preset_label(index: int) -> str: ...
